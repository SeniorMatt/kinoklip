{
    "version": 1,
    "comment": "Built-in render presets of the Deliver page. 'settings' uses the ExportSettings JSON form (src/export/ExportSettings.h); keys left out keep the defaults. Output path and render range are never part of a preset.",
    "presets": [
        {
            "id": "youtube_1080p",
            "name": "YouTube 1080p",
            "category": "Web",
            "description": "H.264 MP4, 1920x1080, constant quality 18, AAC 320 kb/s",
            "settings": {
                "container": "mp4",
                "video": { "codec": "h264", "encoder": "auto", "rateControl": "quality", "quality": 18, "speed": "medium", "width": 1920, "height": 1080 },
                "audio": { "enabled": true, "codec": "aac", "bitrateKbps": 320, "sampleRate": 48000 }
            }
        },
        {
            "id": "youtube_4k",
            "name": "YouTube 4K",
            "category": "Web",
