                "container": "mp4",
                "video": { "codec": "h264", "encoder": "auto", "rateControl": "quality", "quality": 18, "speed": "medium", "width": 3840, "height": 2160 },
                "audio": { "enabled": true, "codec": "aac", "bitrateKbps": 320, "sampleRate": 48000 }
            }
