{
"formatVersion": 1,
"description": "Default Vim keys of Kinoklip (spec section 83). Entries: context (global, timeline, viewer; a viewer inherits the timeline and global entries), modes (n NORMAL, v VISUAL), keys, run (vim:<builtin>, action:<registry id>, ex:<line>), type (motion, operator, command, mode, group), desc. Generated docs: docs/keymaps/vim-keys.md.",
"bindings": [
 {"context": "timeline", "modes": "nvo", "keys": "g", "type": "group", "desc": "go to"},
 {"context": "timeline", "modes": "nvo", "keys": "]", "type": "group", "desc": "next"},
 {"context": "timeline", "modes": "nvo", "keys": "[", "type": "group", "desc": "previous"},
 {"context": "timeline", "modes": "vo", "keys": "i", "type": "group", "desc": "inner (text object)"},
 {"context": "timeline", "modes": "vo", "keys": "a", "type": "group", "desc": "around (text object)"},
 {"context": "timeline", "modes": "nvo", "keys": "h", "run": ["vim:frame_prev"], "type": "motion", "desc": "previous frame", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "l", "run": ["vim:frame_next"], "type": "motion", "desc": "next frame", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "{", "run": ["vim:second_prev"], "type": "motion", "desc": "one second back", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "}", "run": ["vim:second_next"], "type": "motion", "desc": "one second forward", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "0", "run": ["vim:timeline_start"], "type": "motion", "desc": "start of the timeline", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "$", "run": ["vim:timeline_end"], "type": "motion", "desc": "end of the timeline", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "|", "run": ["vim:goto_frame"], "type": "motion", "desc": "frame number (the count), 0 without one", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "^", "run": ["vim:first_clip"], "type": "motion", "desc": "start of the first clip", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "w", "run": ["vim:clip_next"], "type": "motion", "desc": "start of the next clip on the cursor track", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "b", "run": ["vim:clip_prev"], "type": "motion", "desc": "start of this clip, or of the previous one", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "e", "run": ["vim:clip_end"], "type": "motion", "desc": "last frame of this clip, or of the next one", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "ge", "run": ["vim:clip_end_prev"], "type": "motion", "desc": "last frame of the previous clip", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "W", "run": ["vim:edit_next"], "type": "motion", "desc": "next edit point on any track", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "B", "run": ["vim:edit_prev"], "type": "motion", "desc": "previous edit point on any track", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "E", "run": ["vim:edit_end"], "type": "motion", "desc": "last frame before the next edit point on any track", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "gE", "run": ["vim:edit_end_prev"], "type": "motion", "desc": "last frame before the previous edit point on any track", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "]]", "run": ["vim:marker_next"], "type": "motion", "desc": "next marker", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "[[", "run": ["vim:marker_prev"], "type": "motion", "desc": "previous marker", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "]k", "run": ["vim:keyframe_next"], "type": "motion", "desc": "next keyframe of the clip", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "[k", "run": ["vim:keyframe_prev"], "type": "motion", "desc": "previous keyframe of the clip", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "j", "run": ["vim:track_down"], "type": "motion", "desc": "track below (count: that many)", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "k", "run": ["vim:track_up"], "type": "motion", "desc": "track above (count: that many)", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "gg", "run": ["vim:track_first"], "type": "motion", "desc": "first (top) track", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "G", "run": ["vim:track_last"], "type": "motion", "desc": "last (bottom) track; with a count, that track", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "'{a-z}", "run": ["vim:goto_mark"], "type": "motion", "desc": "jump to a remembered place (frame and track)", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "`{a-z}", "run": ["vim:goto_mark"], "type": "motion", "desc": "jump to a remembered place (frame and track)", "repeat": false},
 {"context": "timeline", "modes": "nvo", "keys": "''", "run": ["vim:jump_back"], "type": "motion", "desc": "jump back to where the last jump started", "repeat": false},
 {"context": "timeline", "modes": "nv", "keys": "m{a-z}", "run": ["vim:set_mark"], "type": "command", "desc": "remember the cursor (frame and track) under a letter"},
 {"context": "timeline", "modes": "vo", "keys": "iw", "run": ["vim:obj_iw"], "type": "object", "desc": "clip under the cursor (in a gap: the gap)"},
 {"context": "timeline", "modes": "vo", "keys": "aw", "run": ["vim:obj_aw"], "type": "object", "desc": "clip and the gap after it"},
 {"context": "timeline", "modes": "vo", "keys": "iW", "run": ["vim:obj_iW"], "type": "object", "desc": "clip and the clips linked to it"},
 {"context": "timeline", "modes": "vo", "keys": "aW", "run": ["vim:obj_aW"], "type": "object", "desc": "clip and the clips linked to it"},
 {"context": "timeline", "modes": "vo", "keys": "ip", "run": ["vim:obj_ip"], "type": "object", "desc": "run of touching clips"},
 {"context": "timeline", "modes": "vo", "keys": "ap", "run": ["vim:obj_ap"], "type": "object", "desc": "run of touching clips and the gap after it"},
 {"context": "timeline", "modes": "vo", "keys": "im", "run": ["vim:obj_im"], "type": "object", "desc": "span between the markers around the cursor, every track"},
 {"context": "timeline", "modes": "vo", "keys": "ir", "run": ["vim:obj_ir"], "type": "object", "desc": "In to Out range, every track"},
 {"context": "timeline", "modes": "vo", "keys": "it", "run": ["vim:obj_it"], "type": "object", "desc": "the clips at the cursor frame on every track"},
 {"context": "timeline", "modes": "nv", "keys": "d", "run": ["vim:op_delete"], "type": "operator", "desc": "delete: ripple delete: later material closes up (then a motion or text object; the key twice = the clip under the cursor)"},
 {"context": "timeline", "modes": "nv", "keys": "c", "run": ["vim:op_change"], "type": "operator", "desc": "change: delete leaving a gap and go to INSERT (then a motion or text object; the key twice = the clip under the cursor)"},
 {"context": "timeline", "modes": "nv", "keys": "y", "run": ["vim:op_yank"], "type": "operator", "desc": "yank: copy (then a motion or text object; the key twice = the clip under the cursor)"},
 {"context": "timeline", "modes": "n", "keys": "x", "run": ["vim:cmd_delete"], "type": "command", "desc": "ripple delete the selection, else the clip under the cursor (count: that many)"},
 {"context": "timeline", "modes": "v", "keys": "x", "run": ["vim:op_delete"], "type": "operator", "desc": "ripple delete the selection"},
 {"context": "timeline", "modes": "n", "keys": "X", "run": ["vim:cmd_lift"], "type": "command", "desc": "delete the selection, else the clip under the cursor, leaving a gap"},
 {"context": "timeline", "modes": "v", "keys": "X", "run": ["vim:op_lift"], "type": "operator", "desc": "delete the selection leaving a gap"},
 {"context": "timeline", "modes": "n", "keys": "D", "run": ["vim:cmd_delete_to_end"], "type": "command", "desc": "ripple delete from the cursor to the end of the clip"},
 {"context": "timeline", "modes": "n", "keys": "Y", "run": ["vim:cmd_yank"], "type": "command", "desc": "copy the clip under the cursor (same as yy)"},
 {"context": "timeline", "modes": "n", "keys": "p", "run": ["vim:cmd_paste"], "type": "command", "desc": "paste at the cursor, inserting (count: times; \"a: register a)"},
 {"context": "timeline", "modes": "n", "keys": "P", "run": ["vim:cmd_paste_over"], "type": "command", "desc": "paste at the cursor, overwriting"},
 {"context": "timeline", "modes": "v", "keys": "p", "run": ["vim:visual_paste"], "type": "command", "desc": "replace the selection with the register"},
 {"context": "timeline", "modes": "v", "keys": "P", "run": ["vim:visual_paste"], "type": "command", "desc": "replace the selection with the register"},
 {"context": "timeline", "modes": "n", "keys": ".", "run": ["vim:repeat"], "type": "command", "desc": "repeat the last change (a count replaces its count)"},
 {"context": "timeline", "modes": "nv", "keys": "v", "run": ["vim:visual_char"], "type": "mode", "desc": "VISUAL: frames on the cursor track"},
 {"context": "timeline", "modes": "nv", "keys": "V", "run": ["vim:visual_line"], "type": "mode", "desc": "V-LINE: whole clips"},
 {"context": "timeline", "modes": "nv", "keys": "<C-v>", "run": ["vim:visual_block"], "type": "mode", "desc": "V-BLOCK: frames across tracks"},
 {"context": "timeline", "modes": "v", "keys": "o", "run": ["vim:visual_other_end"], "type": "command", "desc": "go to the other end of the selection"},
 {"context": "timeline", "modes": "nv", "keys": "gv", "run": ["vim:visual_reselect"], "type": "mode", "desc": "select the last VISUAL selection again"},
 {"context": "timeline", "modes": "n", "keys": "s", "run": ["vim:cursor_select", "action:edit.split", "vim:cursor_unselect"], "type": "command", "desc": "split the clip at the cursor", "dot": true},
 {"context": "timeline", "modes": "n", "keys": "J", "run": ["vim:cursor_select", "action:edit.join", "vim:cursor_unselect"], "type": "command", "desc": "join the clip with the next one (through edit)", "dot": true},
 {"context": "timeline", "modes": "n", "keys": "~", "run": ["vim:cursor_select", "action:clip.toggle_enabled", "vim:cursor_unselect"], "type": "command", "desc": "enable / disable the clip", "dot": true},
 {"context": "timeline", "modes": "n", "keys": "r", "run": ["vim:cursor_select", "action:edit.replace", "vim:cursor_unselect"], "type": "command", "desc": "replace the clip with the source clip", "dot": true},
 {"context": "timeline", "modes": "n", "keys": "R", "run": ["vim:cursor_select", "action:edit.ripple_overwrite", "vim:cursor_unselect"], "type": "command", "desc": "ripple overwrite with the source clip", "dot": true},
 {"context": "timeline", "modes": "n", "keys": ">", "run": ["vim:cursor_select", "action:trim.nudge_right", "vim:cursor_unselect"], "type": "command", "desc": "nudge the clip one frame right (count: frames)", "repeat": true, "dot": true},
 {"context": "timeline", "modes": "n", "keys": "<", "run": ["vim:cursor_select", "action:trim.nudge_left", "vim:cursor_unselect"], "type": "command", "desc": "nudge the clip one frame left (count: frames)", "repeat": true, "dot": true},
 {"context": "timeline", "modes": "n", "keys": "H", "run": ["action:timeline.prev_tab"], "type": "command", "desc": "previous timeline tab"},
 {"context": "timeline", "modes": "n", "keys": "L", "run": ["action:timeline.next_tab"], "type": "command", "desc": "next timeline tab"},
 {"context": "timeline", "modes": "n", "keys": "n", "run": ["vim:search_next"], "type": "command", "desc": "next search match", "repeat": false},
 {"context": "timeline", "modes": "n", "keys": "N", "run": ["vim:search_prev"], "type": "command", "desc": "previous search match", "repeat": false},
 {"context": "timeline", "modes": "n", "keys": "/", "run": ["vim:search"], "type": "command", "desc": "search markers and clip names"},
 {"context": "global", "modes": "n", "keys": ":", "run": ["vim:command_line"], "type": "command", "desc": "command line (Tab completes, Up / Down recall)"},
 {"context": "global", "modes": "n", "keys": "q", "type": "group", "desc": "history"},
 {"context": "global", "modes": "n", "keys": "q:", "run": ["vim:picker_history"], "type": "command", "desc": "pick a line from the command history and run it"},
 {"context": "global", "modes": "n", "keys": "g", "type": "group", "desc": "go to"},
 {"context": "global", "modes": "n", "keys": "gt", "run": ["vim:page_goto"], "type": "command", "desc": "next page; with a count, page n (1 Media, 2 Cut, 3 Edit, 4 Compositing, 5 Color, 6 Audio, 7 Deliver)"},
 {"context": "global", "modes": "n", "keys": "gT", "run": ["vim:page_prev"], "type": "command", "desc": "previous page (a count: that many back), wrapping round"},
 {"context": "global", "modes": "n", "keys": "<C-h>", "run": ["vim:win_left"], "type": "command", "desc": "focus the panel to the left"},
 {"context": "global", "modes": "n", "keys": "<C-j>", "run": ["vim:win_down"], "type": "command", "desc": "focus the panel below"},
 {"context": "global", "modes": "n", "keys": "<C-k>", "run": ["vim:win_up"], "type": "command", "desc": "focus the panel above"},
 {"context": "global", "modes": "n", "keys": "<C-l>", "run": ["vim:win_right"], "type": "command", "desc": "focus the panel to the right"},
 {"context": "global", "modes": "n", "keys": "<C-w>", "type": "group", "desc": "windows (panels)"},
 {"context": "global", "modes": "n", "keys": "<C-w>h", "run": ["vim:win_left"], "type": "command", "desc": "focus the panel to the left"},
 {"context": "global", "modes": "n", "keys": "<C-w>j", "run": ["vim:win_down"], "type": "command", "desc": "focus the panel below"},
 {"context": "global", "modes": "n", "keys": "<C-w>k", "run": ["vim:win_up"], "type": "command", "desc": "focus the panel above"},
 {"context": "global", "modes": "n", "keys": "<C-w>l", "run": ["vim:win_right"], "type": "command", "desc": "focus the panel to the right"},
 {"context": "global", "modes": "n", "keys": "<C-w>w", "run": ["vim:win_next"], "type": "command", "desc": "next panel in reading order (a count: panel n), wrapping round"},
 {"context": "global", "modes": "n", "keys": "<C-w>W", "run": ["vim:win_prev"], "type": "command", "desc": "previous panel in reading order, wrapping round"},
 {"context": "global", "modes": "n", "keys": "<C-w>p", "run": ["vim:win_last"], "type": "command", "desc": "the panel that had the focus before"},
 {"context": "global", "modes": "n", "keys": "<C-w>o", "run": ["vim:win_only"], "type": "command", "desc": "zoom the focused panel (hide the others); again to bring them back"},
 {"context": "global", "modes": "n", "keys": "<C-w>=", "run": ["vim:win_reset"], "type": "command", "desc": "bring the zoomed panels back and reset the layout"},
 {"context": "global", "modes": "n", "keys": "<C-w>c", "run": ["vim:win_close"], "type": "command", "desc": "hide the focused panel"},
 {"context": "global", "modes": "nv", "keys": "<leader>w", "type": "group", "desc": "panels"},
 {"context": "global", "modes": "n", "keys": "<leader>wm", "run": ["vim:focus_media"], "type": "command", "desc": "focus the Media Pool (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "<leader>we", "run": ["vim:focus_effects"], "type": "command", "desc": "focus the Effects (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "<leader>wi", "run": ["vim:focus_inspector"], "type": "command", "desc": "focus the Inspector (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "<leader>wt", "run": ["vim:focus_timeline"], "type": "command", "desc": "focus the timeline (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "<leader>wv", "run": ["vim:focus_viewer"], "type": "command", "desc": "focus the viewer (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "<leader>wk", "run": ["vim:focus_keyframes"], "type": "command", "desc": "focus the Keyframes (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "<leader>wx", "run": ["vim:focus_mixer"], "type": "command", "desc": "focus the Mixer (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "<leader>wn", "run": ["vim:focus_nodes"], "type": "command", "desc": "focus the Nodes (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "<leader>wd", "run": ["vim:focus_metadata"], "type": "command", "desc": "focus the Metadata (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "<leader>wl", "run": ["vim:focus_index"], "type": "command", "desc": "focus the Edit Index (shown if hidden)"},
 {"context": "global", "modes": "n", "keys": "u", "run": ["action:edit.undo"], "type": "command", "desc": "undo (count: that many steps)", "repeat": true},
 {"context": "list", "modes": "nvo", "keys": "j", "run": ["vim:row_down"], "type": "motion", "desc": "row below (count: that many)", "repeat": false},
 {"context": "list", "modes": "nvo", "keys": "k", "run": ["vim:row_up"], "type": "motion", "desc": "row above (count: that many)", "repeat": false},
 {"context": "list", "modes": "nvo", "keys": "gg", "run": ["vim:row_first"], "type": "motion", "desc": "first row", "repeat": false},
 {"context": "list", "modes": "nvo", "keys": "G", "run": ["vim:row_last"], "type": "motion", "desc": "last row; with a count, that row", "repeat": false},
 {"context": "list", "modes": "nvo", "keys": "<C-d>", "run": ["vim:row_half_down"], "type": "motion", "desc": "half a page down", "repeat": false},
 {"context": "list", "modes": "nvo", "keys": "<C-u>", "run": ["vim:row_half_up"], "type": "motion", "desc": "half a page up", "repeat": false},
 {"context": "list", "modes": "nv", "keys": "d", "run": ["vim:op_delete"], "type": "operator", "desc": "delete the rows (the panel asks first where it must; then a motion, or d again for this row)"},
 {"context": "list", "modes": "nv", "keys": "y", "run": ["vim:op_yank"], "type": "operator", "desc": "yank: copy the names of the rows to the system clipboard (then a motion, or y again)"},
 {"context": "list", "modes": "n", "keys": "x", "run": ["vim:cmd_delete"], "type": "command", "desc": "delete the selected rows, else this row (count: that many)"},
 {"context": "list", "modes": "v", "keys": "x", "run": ["vim:op_delete"], "type": "operator", "desc": "delete the selected rows"},
 {"context": "list", "modes": "n", "keys": "p", "run": ["vim:cmd_paste"], "type": "command", "desc": "paste (Ctrl+V of the panel: the Media Pool imports files from the clipboard)"},
 {"context": "list", "modes": "n", "keys": "P", "run": ["vim:cmd_paste"], "type": "command", "desc": "paste (Ctrl+V of the panel)"},
 {"context": "list", "modes": "nv", "keys": "V", "run": ["vim:visual_line"], "type": "mode", "desc": "V-LINE: select rows (j and k grow it)"},
 {"context": "list", "modes": "nv", "keys": "v", "run": ["vim:visual_line"], "type": "mode", "desc": "V-LINE: select rows (j and k grow it)"},
 {"context": "list", "modes": "v", "keys": "o", "run": ["vim:visual_other_end"], "type": "command", "desc": "go to the other end of the selection"},
 {"context": "list", "modes": "n", "keys": ".", "run": ["vim:repeat"], "type": "command", "desc": "repeat the last change"},
 {"context": "list", "modes": "n", "keys": "o", "run": ["vim:list_open"], "type": "command", "desc": "open the row (a bin, a clip in the Source viewer, apply an effect)"},
 {"context": "list", "modes": "n", "keys": "l", "run": ["vim:list_right"], "type": "command", "desc": "open a closed branch, else open the row"},
 {"context": "list", "modes": "n", "keys": "h", "run": ["vim:list_left"], "type": "command", "desc": "close an open branch, else go to the parent row"},
 {"context": "list", "modes": "n", "keys": "-", "run": ["vim:list_parent"], "type": "command", "desc": "the parent row, or the parent bin"},
 {"context": "list", "modes": "n", "keys": "a", "run": ["vim:list_new"], "type": "command", "desc": "new bin (Media Pool)"},
 {"context": "list", "modes": "n", "keys": "r", "run": ["vim:list_rename"], "type": "command", "desc": "rename the row (F2)"},
 {"context": "list", "modes": "n", "keys": "/", "run": ["vim:search"], "type": "command", "desc": "search: the panel's search field, else a search of the row names"},
 {"context": "list", "modes": "n", "keys": "n", "run": ["vim:search_next"], "type": "command", "desc": "next match (without a search: next row)", "repeat": false},
 {"context": "list", "modes": "n", "keys": "N", "run": ["vim:search_prev"], "type": "command", "desc": "previous match (without a search: previous row)", "repeat": false},
 {"context": "list", "modes": "n", "keys": "z", "type": "group", "desc": "folds and scrolling"},
 {"context": "list", "modes": "n", "keys": "za", "run": ["vim:list_fold_toggle"], "type": "command", "desc": "open / close the branch"},
 {"context": "list", "modes": "n", "keys": "zo", "run": ["vim:list_fold_open"], "type": "command", "desc": "open the branch"},
 {"context": "list", "modes": "n", "keys": "zc", "run": ["vim:list_fold_close"], "type": "command", "desc": "close the branch"},
 {"context": "list", "modes": "n", "keys": "zR", "run": ["vim:list_fold_open_all"], "type": "command", "desc": "open every branch"},
 {"context": "list", "modes": "n", "keys": "zM", "run": ["vim:list_fold_close_all"], "type": "command", "desc": "close every branch"},
 {"context": "list", "modes": "n", "keys": "zt", "run": ["vim:list_scroll_top"], "type": "command", "desc": "scroll the row to the top"},
 {"context": "list", "modes": "n", "keys": "zz", "run": ["vim:list_scroll_middle"], "type": "command", "desc": "scroll the row to the middle"},
 {"context": "list", "modes": "n", "keys": "zb", "run": ["vim:list_scroll_bottom"], "type": "command", "desc": "scroll the row to the bottom"},
 {"context": "global", "modes": "nv", "keys": "<leader>y", "run": ["vim:copy_timecode"], "type": "command", "desc": "copy the timecode of the cursor to the system clipboard"},
 {"context": "timeline", "modes": "nv", "keys": "z", "type": "group", "desc": "zoom"},
 {"context": "timeline", "modes": "nv", "keys": "zi", "run": ["action:timeline.zoom_in"], "type": "command", "desc": "zoom in"},
 {"context": "timeline", "modes": "nv", "keys": "zo", "run": ["action:timeline.zoom_out"], "type": "command", "desc": "zoom out"},
 {"context": "timeline", "modes": "nv", "keys": "zf", "run": ["action:timeline.zoom_fit"], "type": "command", "desc": "zoom to fit"},
 {"context": "timeline", "modes": "n", "keys": "u", "run": ["action:edit.undo"], "type": "command", "desc": "undo (count: that many steps)", "repeat": true},
 {"context": "timeline", "modes": "n", "keys": "M", "run": ["action:mark.add_marker"], "type": "command", "desc": "add a marker at the playhead"},
 {"context": "timeline", "modes": "n", "keys": "i", "run": ["vim:insert_mode"], "type": "mode", "desc": "INSERT: the keyboard profile's shortcuts work (Esc comes back)"},
 {"context": "timeline", "modes": "n", "keys": "a", "run": ["vim:insert_mode"], "type": "mode", "desc": "INSERT: the keyboard profile's shortcuts work (Esc comes back)"},
 {"context": "viewer", "modes": "nv", "keys": "zf", "run": ["action:view.viewer_zoom_fit"], "type": "command", "desc": "fit the viewer image to its window"},
 {"context": "viewer", "modes": "n", "keys": "gf", "run": ["action:view.fullscreen_viewer"], "type": "command", "desc": "full-screen viewer"},
