{
"formatVersion": 1,
"description": "Default Vim keys of Kinoklip (spec section 83). Entries: context (global, timeline, viewer; a viewer inherits the timeline and global entries), modes (n NORMAL, v VISUAL), keys, run (vim:<builtin>, action:<registry id>, ex:<line>), type (motion, operator, command, mode, group), desc. Generated docs: docs/keymaps/vim-keys.md.",
"bindings": [
 {"context": "timeline", "modes": "nv", "keys": "h", "run": ["action:transport.prev_frame"], "type": "motion", "desc": "previous frame", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "l", "run": ["action:transport.next_frame"], "type": "motion", "desc": "next frame", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "H", "run": ["action:transport.back_1s"], "type": "motion", "desc": "one second back", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "L", "run": ["action:transport.forward_1s"], "type": "motion", "desc": "one second forward", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "w", "run": ["action:transport.next_edit"], "type": "motion", "desc": "next edit point", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "b", "run": ["action:transport.prev_edit"], "type": "motion", "desc": "previous edit point", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "n", "run": ["action:transport.next_marker"], "type": "motion", "desc": "next marker", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "N", "run": ["action:transport.prev_marker"], "type": "motion", "desc": "previous marker", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "]]", "run": ["action:transport.next_marker"], "type": "motion", "desc": "next marker", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "[[", "run": ["action:transport.prev_marker"], "type": "motion", "desc": "previous marker", "repeat": true},
 {"context": "timeline", "modes": "nv", "keys": "0", "run": ["action:transport.go_to_start"], "type": "motion", "desc": "start of the timeline", "repeat": false},
 {"context": "timeline", "modes": "nv", "keys": "$", "run": ["action:transport.go_to_end"], "type": "motion", "desc": "end of the timeline", "repeat": false},
 {"context": "timeline", "modes": "nv", "keys": "gg", "run": ["action:transport.go_to_start"], "type": "motion", "desc": "start of the timeline", "repeat": false},
 {"context": "timeline", "modes": "nv", "keys": "G", "run": ["action:transport.go_to_end"], "type": "motion", "desc": "end of the timeline", "repeat": false},
 {"context": "timeline", "modes": "nv", "keys": "g", "type": "group", "desc": "go to"},
 {"context": "timeline", "modes": "nv", "keys": "z", "type": "group", "desc": "zoom"},
 {"context": "timeline", "modes": "nv", "keys": "]", "type": "group", "desc": "next"},
 {"context": "timeline", "modes": "nv", "keys": "[", "type": "group", "desc": "previous"},
 {"context": "timeline", "modes": "nv", "keys": "zi", "run": ["action:timeline.zoom_in"], "type": "command", "desc": "zoom in"},
 {"context": "timeline", "modes": "nv", "keys": "zo", "run": ["action:timeline.zoom_out"], "type": "command", "desc": "zoom out"},
 {"context": "timeline", "modes": "nv", "keys": "zf", "run": ["action:timeline.zoom_fit"], "type": "command", "desc": "zoom to fit"},
 {"context": "timeline", "modes": "nv", "keys": "m{a-z}", "run": ["vim:set_mark"], "type": "command", "desc": "remember the playhead position under a letter"},
 {"context": "timeline", "modes": "nv", "keys": "'{a-z}", "run": ["vim:goto_mark"], "type": "motion", "desc": "jump to a remembered position"},
 {"context": "timeline", "modes": "nv", "keys": "`{a-z}", "run": ["vim:goto_mark"], "type": "motion", "desc": "jump to a remembered position"},
 {"context": "timeline", "modes": "n", "keys": "j", "run": ["vim:target_down"], "type": "motion", "desc": "target video track one down"},
 {"context": "timeline", "modes": "n", "keys": "k", "run": ["vim:target_up"], "type": "motion", "desc": "target video track one up"},
 {"context": "timeline", "modes": "n", "keys": "dd", "run": ["vim:delete_clips"], "type": "operator", "desc": "ripple delete the clip under the playhead (count: and the next ones)"},
 {"context": "timeline", "modes": "n", "keys": "yy", "run": ["vim:yank_clips"], "type": "operator", "desc": "copy the clip under the playhead (count: and the next ones)"},
 {"context": "timeline", "modes": "n", "keys": "x", "run": ["action:edit.ripple_delete"], "type": "command", "desc": "ripple delete the selection"},
 {"context": "timeline", "modes": "n", "keys": "X", "run": ["action:edit.delete"], "type": "command", "desc": "delete the selection, leave a gap"},
 {"context": "timeline", "modes": "n", "keys": "p", "run": ["action:edit.paste_insert"], "type": "command", "desc": "paste at the playhead, inserting"},
 {"context": "timeline", "modes": "n", "keys": "P", "run": ["action:edit.paste"], "type": "command", "desc": "paste at the playhead, overwriting"},
 {"context": "timeline", "modes": "n", "keys": "u", "run": ["action:edit.undo"], "type": "command", "desc": "undo (count: that many steps)", "repeat": true},
 {"context": "timeline", "modes": "n", "keys": "s", "run": ["action:edit.split"], "type": "command", "desc": "split at the playhead"},
 {"context": "timeline", "modes": "n", "keys": "M", "run": ["action:mark.add_marker"], "type": "command", "desc": "add a marker at the playhead"},
 {"context": "timeline", "modes": "n", "keys": ">", "run": ["action:trim.nudge_right"], "type": "command", "desc": "nudge the selection one frame right (count: frames)", "repeat": true},
 {"context": "timeline", "modes": "n", "keys": "<", "run": ["action:trim.nudge_left"], "type": "command", "desc": "nudge the selection one frame left (count: frames)", "repeat": true},
 {"context": "timeline", "modes": "n", "keys": "v", "run": ["vim:visual_start"], "type": "mode", "desc": "VISUAL: select from here to the playhead"},
 {"context": "timeline", "modes": "v", "keys": "v", "run": ["vim:visual_leave"], "type": "mode", "desc": "leave VISUAL, clear the selection"},
 {"context": "timeline", "modes": "v", "keys": "d", "run": ["vim:visual_delete"], "type": "operator", "desc": "ripple delete the selection, back to NORMAL"},
 {"context": "timeline", "modes": "v", "keys": "x", "run": ["vim:visual_delete"], "type": "operator", "desc": "ripple delete the selection, back to NORMAL"},
 {"context": "timeline", "modes": "v", "keys": "X", "run": ["vim:visual_delete_gap"], "type": "operator", "desc": "delete the selection leaving a gap, back to NORMAL"},
 {"context": "timeline", "modes": "v", "keys": "y", "run": ["vim:visual_yank"], "type": "operator", "desc": "copy the selection, back to NORMAL"},
 {"context": "timeline", "modes": "n", "keys": "i", "run": ["vim:insert_mode"], "type": "mode", "desc": "INSERT: the keyboard profile's shortcuts work (Esc comes back)"},
 {"context": "timeline", "modes": "n", "keys": "a", "run": ["vim:insert_mode"], "type": "mode", "desc": "INSERT: the keyboard profile's shortcuts work (Esc comes back)"},
 {"context": "timeline", "modes": "n", "keys": ":", "run": ["vim:command_line"], "type": "command", "desc": "command line"},
 {"context": "timeline", "modes": "n", "keys": "/", "run": ["vim:search"], "type": "command", "desc": "search"},
 {"context": "viewer", "modes": "nv", "keys": "zf", "run": ["action:view.viewer_zoom_fit"], "type": "command", "desc": "fit the viewer image to its window"},
 {"context": "viewer", "modes": "n", "keys": "gf", "run": ["action:view.fullscreen_viewer"], "type": "command", "desc": "full-screen viewer"},
 {"context": "global", "modes": "nv", "keys": "<C-r>", "run": ["action:edit.redo"], "type": "command", "desc": "redo"},
 {"context": "global", "modes": "n", "keys": "gj", "run": ["action:transport.shuttle_reverse"], "type": "command", "desc": "shuttle reverse (J)"},
 {"context": "global", "modes": "n", "keys": "gk", "run": ["action:transport.shuttle_stop"], "type": "command", "desc": "shuttle stop (K)"},
 {"context": "global", "modes": "n", "keys": "gl", "run": ["action:transport.shuttle_forward"], "type": "command", "desc": "shuttle forward (L)"},
 {"context": "global", "modes": "n", "keys": "<leader><leader>", "run": ["action:transport.play_pause"], "type": "command", "desc": "play / pause"},
 {"context": "global", "modes": "nv", "keys": "<leader>", "type": "group", "desc": "leader"},
 {"context": "global", "modes": "nv", "keys": "<leader>s", "type": "group", "desc": "source edits"},
 {"context": "global", "modes": "n", "keys": "<leader>si", "run": ["action:edit.insert"], "type": "command", "desc": "insert the source clip"},
 {"context": "global", "modes": "n", "keys": "<leader>so", "run": ["action:edit.overwrite"], "type": "command", "desc": "overwrite with the source clip"},
 {"context": "global", "modes": "n", "keys": "<leader>sa", "run": ["action:edit.append_at_end"], "type": "command", "desc": "append the source clip at the end"},
 {"context": "global", "modes": "n", "keys": "<leader>sr", "run": ["action:edit.replace"], "type": "command", "desc": "replace with the source clip"},
 {"context": "global", "modes": "n", "keys": "<leader>sf", "run": ["action:edit.fit_to_fill"], "type": "command", "desc": "fit to fill"},
 {"context": "global", "modes": "n", "keys": "<leader>st", "run": ["action:edit.ripple_overwrite"], "type": "command", "desc": "ripple overwrite"},
 {"context": "global", "modes": "nv", "keys": "<leader>m", "type": "group", "desc": "markers"},
 {"context": "global", "modes": "n", "keys": "<leader>ma", "run": ["action:mark.add_marker"], "type": "command", "desc": "add a marker"},
 {"context": "global", "modes": "n", "keys": "<leader>mm", "run": ["action:mark.modify_marker"], "type": "command", "desc": "modify the marker"},
 {"context": "global", "modes": "n", "keys": "<leader>md", "run": ["action:mark.delete_marker"], "type": "command", "desc": "delete the marker"},
 {"context": "global", "modes": "n", "keys": "<leader>mc", "run": ["action:mark.clip"], "type": "command", "desc": "mark the clip (In and Out)"},
 {"context": "global", "modes": "nv", "keys": "<leader>i", "type": "group", "desc": "in and out"},
 {"context": "global", "modes": "n", "keys": "<leader>ii", "run": ["action:mark.in"], "type": "command", "desc": "mark In"},
 {"context": "global", "modes": "n", "keys": "<leader>io", "run": ["action:mark.out"], "type": "command", "desc": "mark Out"},
 {"context": "global", "modes": "n", "keys": "<leader>ip", "run": ["action:transport.play_in_out"], "type": "command", "desc": "play In to Out"},
 {"context": "global", "modes": "nv", "keys": "<leader>k", "type": "group", "desc": "keyframes"},
 {"context": "global", "modes": "n", "keys": "<leader>kk", "run": ["action:clip.add_keyframe"], "type": "command", "desc": "add a keyframe at the playhead"},
 {"context": "global", "modes": "n", "keys": "<leader>kd", "run": ["action:clip.delete_keyframe"], "type": "command", "desc": "delete the keyframe"},
 {"context": "global", "modes": "n", "keys": "<leader>kl", "run": ["action:clip.keyframe_linear"], "type": "command", "desc": "linear keyframe"},
 {"context": "global", "modes": "n", "keys": "<leader>ki", "run": ["action:clip.keyframe_ease_in"], "type": "command", "desc": "ease in"},
 {"context": "global", "modes": "n", "keys": "<leader>ko", "run": ["action:clip.keyframe_ease_out"], "type": "command", "desc": "ease out"},
 {"context": "global", "modes": "n", "keys": "<leader>kb", "run": ["action:clip.keyframe_ease_in_out"], "type": "command", "desc": "ease in and out"},
 {"context": "global", "modes": "nv", "keys": "<leader>e", "type": "group", "desc": "transitions"},
 {"context": "global", "modes": "n", "keys": "<leader>ee", "run": ["action:timeline.add_transition"], "type": "command", "desc": "add the default transition"},
 {"context": "global", "modes": "nv", "keys": "<leader>t", "type": "group", "desc": "tracks"},
 {"context": "global", "modes": "n", "keys": "<leader>tv", "run": ["action:timeline.add_video_track"], "type": "command", "desc": "add a video track"},
 {"context": "global", "modes": "n", "keys": "<leader>ta", "run": ["action:timeline.add_audio_track"], "type": "command", "desc": "add an audio track"},
 {"context": "global", "modes": "n", "keys": "<leader>td", "run": ["action:timeline.delete_empty_tracks"], "type": "command", "desc": "delete empty tracks"},
 {"context": "global", "modes": "nv", "keys": "<leader>o", "type": "group", "desc": "options"},
 {"context": "global", "modes": "n", "keys": "<leader>os", "run": ["action:timeline.snapping"], "type": "command", "desc": "snapping on / off"},
 {"context": "global", "modes": "n", "keys": "<leader>ol", "run": ["action:timeline.linked_selection"], "type": "command", "desc": "linked selection on / off"},
 {"context": "global", "modes": "n", "keys": "<leader>oa", "run": ["action:timeline.audio_scrubbing"], "type": "command", "desc": "audio scrubbing on / off"},
 {"context": "global", "modes": "n", "keys": "<leader>oL", "run": ["action:transport.loop"], "type": "command", "desc": "loop on / off"},
 {"context": "global", "modes": "nv", "keys": "<leader>f", "type": "group", "desc": "find and files"},
 {"context": "global", "modes": "n", "keys": "<leader>fp", "run": ["action:file.project_manager"], "type": "command", "desc": "projects"},
 {"context": "global", "modes": "n", "keys": "<leader>n", "run": ["action:view.toggle_media_pool"], "type": "command", "desc": "show / hide the Media Pool"},
 {"context": "global", "modes": "n", "keys": "<leader>x", "run": ["action:timeline.close_tab"], "type": "command", "desc": "close the timeline tab"}
]
}
