{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinoklip/kinoklip/docs/plugins/plugin.schema.json",
  "title": "Kinoklip plugin manifest (plugin.json), plugin API 1",
  "description": "The manifest of a Kinoklip plugin. Kinoklip itself validates with the same rules and names the failing field; this file lets an editor or an AI check the file before installing.",
  "type": "object",
  "required": ["id", "name", "version", "author", "license", "api"],
  "anyOf": [
    { "required": ["effects"] },
    { "required": ["transitions"] },
    { "required": ["presets"] },
    { "required": ["scripts"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$", "description": "Reverse-DNS style id, e.g. com.example.tint. Stored in projects: never change it after release." },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?([-+][0-9A-Za-z.-]+)?$" },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1, "description": "SPDX identifier, e.g. MIT or GPL-3.0-or-later." },
    "description": { "type": "string" },
    "homepage": { "type": "string" },
    "api": { "type": "integer", "minimum": 1, "maximum": 1, "description": "Plugin API version the plugin was written for." },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["project.read", "project.edit", "files.read", "files.write", "network", "processes"] }
    },
    "effects": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/effect" } },
    "transitions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/transition" } },
    "presets": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/preset" } },
    "scripts": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/script" } }
  },
  "$defs": {
    "itemId": { "type": "string", "pattern": "^[a-z0-9_]{1,48}$" },
    "relativePath": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|\\\\|:|(^|/)\\.\\.?(/|$))" } },
    "params": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/param" } },
    "effect": {
      "type": "object",
      "required": ["id", "name", "file"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "type": "string", "description": "Effects Library folder: blur, color, distort, key, light, stylize, time, temporal, texture, revival, sharpen, refine, transform, or any text for a folder of your own. Default: Plugins." },
        "file": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.(glsl|frag)$" }] },
        "entry": { "enum": ["main", "color"], "default": "main" },
        "ported_from": { "type": "string" },
        "padding_px": { "type": "number", "minimum": 0, "maximum": 2000 },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["id", "name", "file"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "type": "string", "description": "dissolve, iris, motion, shape, wipe, or any text. Default: Plugins." },
        "file": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.(glsl|frag)$" }] },
        "ported_from": { "type": "string" },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "preset": {
      "type": "object",
      "required": ["id", "name", "file"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "type": "string" },
        "target": { "enum": ["clip", "playhead", "edit_point"], "default": "clip" },
        "file": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.json$" }] }
      }
    },
    "script": {
      "type": "object",
      "required": ["id", "name", "file"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "interpreter": { "enum": ["python3"], "default": "python3" },
        "file": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "\\.py$" }] },
        "permissions": {
          "type": "array",
          "items": { "enum": ["project.read", "project.edit", "files.read", "files.write", "network", "processes"] }
        }
      }
    },
    "param": {
      "type": "object",
      "required": ["key", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$", "description": "Becomes the shader uniform u_<key>." },
        "label": { "type": "string" },
        "tooltip": { "type": "string" },
        "unit": { "type": "string" },
        "type": { "enum": ["number", "integer", "boolean", "color", "choice", "string"] },
        "keyframable": { "type": "boolean", "default": true },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "default": {},
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object", "required": ["value"], "properties": { "value": { "type": "string", "minLength": 1 }, "label": { "type": "string" } } }
            ]
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["number", "integer"] } } }, "then": { "required": ["min", "max", "default"], "properties": { "default": { "type": "number" } } } },
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "required": ["default"], "properties": { "default": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "color" } } }, "then": { "required": ["default"], "properties": { "default": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" } } } },
        { "if": { "properties": { "type": { "const": "choice" } } }, "then": { "required": ["default", "choices"], "properties": { "default": { "type": "string" } } } }
      ]
    }
  }
}
